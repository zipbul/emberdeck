        "guarantee": "getUncoveredSymbols returns gildash-indexed symbols that are not bound by any card's codeLinks or boundary glob, narrowed by caller-supplied kinds/files/excludePatterns and project ignorePatterns.",
        "keyword": "MUST",
        "binds": [
          {
            "file": "src/ops/spec-sync.ts",
            "symbol": "getUncoveredSymbols"
          }
        ],
        "derives": "code-binding/link-and-coverage#G-003"
      },
      {
        "id": "POST-002",
        "guarantee": "suggestCardScope produces card suggestions with type, files, symbols, and reason.",
        "keyword": "SHALL",
        "binds": [
          {
            "file": "src/ops/spec-sync.ts",
            "symbol": "suggestCardScope"
          }
        ],
        "derives": "code-binding/link-and-coverage#G-003"
      },
      {
        "id": "POST-003",
        "guarantee": "Each uncovered entry contains only {file, symbol, kind} fields; no visibility metadata is exposed.",
        "keyword": "MUST",
        "binds": [
          {
            "file": "src/ops/spec-sync.ts",
            "symbol": "getUncoveredSymbols"
          }
        ],
        "derives": "code-binding/link-and-coverage#G-003"
      },
      {
        "id": "POST-004",
        "guarantee": "coverageRatio is null when no symbols are indexed; otherwise it equals coveredSymbols divided by totalSymbols.",
        "keyword": "MUST",
        "binds": [
          {
            "file": "src/ops/spec-sync.ts",
            "symbol": "getUncoveredSymbols"
          }
        ],
        "derives": "code-binding/link-and-coverage#G-003"
      }
    ],
    "invariants": [
      {
        "id": "INV-001",
        "statement": "Symbol visibility (exported vs internal) is not a filter axis for coverage classification.",
        "binds": [
          {
            "file": "src/ops/spec-sync.ts",
            "symbol": "getUncoveredSymbols"
          }
        ],
        "always_holds": "per-call"
      },
      {
        "id": "INV-002",
        "statement": "suggestCardScope derives its uncovered set by calling getUncoveredSymbols; the two functions cannot disagree about which symbols are covered.",
        "binds": [
          {
            "file": "src/ops/spec-sync.ts",
            "symbol": "getUncoveredSymbols"
