{
  // Emberdeck self-dogfooding config
  "projectRoot": ".",
  "ignorePatterns": [
    "dist/**",
    "test/**",
    "bench/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "drizzle/**",
    // Type and error declarations covered by parent specs implicitly
    "src/card/types.ts",
    "src/card/errors.ts",
    "src/card/json-fields.ts",
    "src/card/searchable-text.ts",
    // CLI command actions are now individually bound to per-command spec cards
    // (cli-surface/command-routing-and-output/commands/<key>) via @spec JSDoc on
    // exported action functions (Phase 2.0). Do NOT ignore src/cli/commands/** or
    // src/cli/index.ts here — gildash must index them so `ed spec sync` can resolve
    // the bindings and `ed card set-status active` can pass the activation guard.
    "src/cli/exit-codes.ts",
    "src/cli/usage-error.ts",
    "src/cli/parse-input.ts",
    "src/cli/parsers.ts",
    "src/cli/confirm.ts",
    "src/cli/context.ts",
    // DB repository implementations are single-file and covered by card-storage/persistence
    "src/db/card-repo.ts",
    "src/db/changelog-repo.ts",
    "src/db/classification-repo.ts",
    "src/db/code-link-repo.ts",
    "src/db/relation-repo.ts",
    "src/db/repository.ts",
    "src/db/schema.ts",
    // Pure helpers
    "src/util/**",
    "src/glossary/io.ts",
    "src/fs/reader.ts",
    "src/fs/writer.ts",
    "src/config.ts",
    "index.ts"
  ]
}
